{
  "name": "@ethos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "build": "echo 'no server build needed — TypeScript runs directly'",
    "start": "node src/index.ts",
    "clean": "rm -rf __generated__",
    "codegen": "node --import=./src/core/preload-env.ts src/graphql/write-schema.ts && graphql-codegen-esm"
  },
  "dependencies": {
    "@cubicecho/graphql-mcp": "^3.0.0",
    "@escape.tech/graphql-armor-max-aliases": "^2.6.2",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@ethos/db": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vantreeseba/drizzle-graphql": "^13.0.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-query-complexity": "^2.0.0",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.4",
    "nodemailer": "^8.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2"
  }
}
