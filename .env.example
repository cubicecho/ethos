# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Ethos is Postgres-only and refuses to boot
# without this. `npm run db:up` starts one matching this default.
#
# If your Docker daemon is another machine (`docker context ls` shows something
# like ssh://docker.lan), the database is on *that* host, not this one — put its
# name here. `npm run db:up` prints the line to use.
DATABASE_URL=postgres://ethos:ethos@127.0.0.1:5438/ethos

# Secret used to sign session and magic-link tokens. The server refuses to start
# in production while this is unset or still the default.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Public URL the app is served at. Magic-link URLs are built from it, so set it
# to the address users actually type — a link to localhost is useless in an
# inbox. Defaults to http://localhost:PORT, which is right in production, where
# one server serves both the API and the app. In development the app is on the
# Expo dev server instead, so point this at that: a magic link has to land on
# the client that knows what to do with it.
# APP_URL=http://localhost:3000

# Port the server listens on. Default: 3006
# PORT=3006

# Set to "false" to skip magic-link verification entirely: requesting a link
# signs you straight in and returns a session token. Intended for a private
# self-hosted instance with no mail relay. Never do this on the open internet.
# AUTH_MAGIC_LINK=true

# Return the magic link in the API response so it can be copied from the login
# page. Defaults to true outside production; set it explicitly to run a
# production instance that has no way to send mail.
# EXPOSE_MAGIC_LINK=false

# Where the Expo dev client looks for the API. Only used by `npm run dev:app`;
# in production the server serves the built app from its own origin. Unset, the
# client calls PORT on whatever host the page was opened from, so the dev server
# works over the network without configuration.
# EXPO_PUBLIC_API_URL=http://localhost:3006

# Port the dev client calls the API on, when EXPO_PUBLIC_API_URL is unset.
# Set this to match PORT if you change it. Default: 3006
# EXPO_PUBLIC_API_PORT=3006

# Address `npm run db:up` publishes the dev Postgres on. Left unset it follows
# the Docker context: 127.0.0.1 when the daemon is this machine, 0.0.0.0 when it
# is not — a container published on loopback binds the *daemon host's* loopback,
# which nothing here can reach. Set it explicitly to overrule that. An
# unencrypted Postgres with a throwaway password wants a network you trust.
# POSTGRES_BIND=127.0.0.1

# Host port the dev Postgres is published on. Default: 5438
# POSTGRES_PORT=5438

# Port the Expo dev server serves the app on — this is the one you open in a
# browser during development. Set in app/package.json's `dev` script. Default: 3000
