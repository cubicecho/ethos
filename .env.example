# DATABASE_URL and BETTER_AUTH_SECRET are required, and one of SMTP_URL, an
# OpenID Connect provider and SECURE_LOCAL_NET is what lets anyone sign in.

# PostgreSQL connection string. Ethos is Postgres-only and refuses to boot
# without this; `npm run db:up` starts one matching this default.
#
# If your Docker daemon is another machine (`docker context ls` shows something
# like ssh://docker.lan), the database is on *that* host — put its name here.
# `npm run db:up` prints the line to use.
DATABASE_URL=postgres://ethos:ethos@127.0.0.1:5438/ethos

# Secret better-auth signs with. The server refuses to start in production while
# this is unset, still the value below, or shorter than 32 characters.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# How people sign in. Set one of the two.
#
# SMTP_URL emails a one-time sign-in link, which is never logged and never shown
# on the login page. Any SMTP relay works: smtps://user:pass@smtp.example.com:465
# SMTP_URL=
#
# The address those emails come from. Default: ethos@<the host in APP_URL>
# SMTP_FROM=Ethos <ethos@example.com>
#
# SECURE_LOCAL_NET signs in with an address alone: no link, no mail. An address
# is then the whole credential, so it is for a network you trust and nothing
# else. The server refuses to start with it when APP_URL is a public hostname.
# SECURE_LOCAL_NET=true

# Sign in through an OpenID Connect provider (heautou, Keycloak, Authentik, …).
# The easier way is to leave these unset and paste a setup URL from the
# provider into the login page (on a new instance) or Settings (as the admin):
# Ethos then registers itself with the provider. Set here, the provider wins and
# cannot be changed from the app. Register the redirect URI the server prints at
# boot: <SERVER_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=ethos
# OIDC_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post; the provider must agree.
# OIDC_CLIENT_AUTH=client_secret_basic
# What the login page's button calls it. Default: SSO
# OIDC_NAME=heautou

# Everything below is optional.

# Public URL the app is served at. Sign-in links are built from it, so set it
# to the address users actually type — a link to localhost is useless in an
# inbox. In production it is also the only origin a browser may call the API
# from. Defaults to http://localhost:PORT, which is right in production, where
# one server serves both the API and the app. In development point it at the
# Expo dev server, the client that knows what to do with a sign-in link.
# APP_URL=http://localhost:8081

# Where a browser reaches this server, for the OIDC sign-in's start and callback.
# Defaults to APP_URL in production, where they are the same, and to
# http://localhost:PORT in development, where the app is on a port of its own.
# SERVER_URL=http://localhost:3000

# Port the server listens on. Default: 3000
# PORT=3000

# How long the server waits at boot for Postgres to start answering, in
# milliseconds, before it gives up. Default: 60000
# DB_CONNECT_TIMEOUT_MS=60000

# How many reverse proxies sit in front of the server. Sign-in is throttled per
# client address, and behind a proxy that address is in X-Forwarded-For, which
# the server believes only when told to. Leave unset with no proxy; set 1 behind
# one (nginx, Caddy, Traefik). Unset behind a proxy, every visitor shares the
# proxy's address and one sign-in budget. Default: false
# TRUST_PROXY=1

# Serves the API's queries as MCP tools at /mcp, for an agent to read your
# habits with. Read-only: no mutation is offered. A call needs the same session
# token the web client sends, as `Authorization: Bearer …`. Default: false
# MCP_ENABLED=true

# Where the Expo dev client looks for the API. Only used by `npm run dev:app`;
# in production the server serves the built app from its own origin. Unset, the
# client calls PORT on whatever host the page was opened from, so the dev server
# works over the network without configuration.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Port the dev client calls the API on, when EXPO_PUBLIC_API_URL is unset.
# Set this to match PORT if you change it. Default: 3000
# EXPO_PUBLIC_API_PORT=3000

# Address `npm run db:up` publishes the dev Postgres on. Left unset it follows
# the Docker context: 127.0.0.1 when the daemon is this machine, 0.0.0.0 when it
# is not, because a container on the *daemon host's* loopback is out of reach
# from here. An unencrypted Postgres with a throwaway password wants a network
# you trust.
# POSTGRES_BIND=127.0.0.1

# Host port the dev Postgres is published on. Default: 5438
# POSTGRES_PORT=5438

# Port the Expo dev server serves the app on — this is the one you open in a
# browser during development. Set in app/package.json's `dev` script. Default: 8081
